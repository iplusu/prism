# Prism — copy to .env and fill in. Never commit .env.
# Values marked REQUIRED have no safe default for a real deployment.

# ------------------------------------------------- listen address (scripts/serve.sh)
# 0.0.0.0 = all interfaces; an IP = only that interface; `tailscale` = this node's Tailscale IPv4
# (reachable only from your tailnet, e.g. http://<machine>.<tailnet>.ts.net:8000)
PRISM_HOST=0.0.0.0
PRISM_PORT=8000

# ---------------------------------------------------------------- core
# PostgreSQL in production (REQUIRED). SQLite is only for development.
DATABASE_URL=postgresql+psycopg://prism:CHANGE_ME@db:5432/prism
# Where projects, builds, proposals, task work copies and tool homes live.
PRISM_DATA_DIR=/srv/prism/data
# REQUIRED: long random string (e.g. `openssl rand -hex 32`).
PRISM_SECRET_KEY=
# true when served over HTTPS
PRISM_COOKIE_SECURE=false
PRISM_SESSION_HOURS=72
# First administrator, created at startup if missing (remove the password afterwards).
PRISM_ADMIN_USERNAME=admin
PRISM_ADMIN_PASSWORD=
PRISM_ALLOW_SIGNUP=false
# DEMO_MODE=true enables a labelled demo executor and rule-based planning when no LLM is
# configured. Never enable it on the production instance.
DEMO_MODE=false

# --------------------------------------------- orchestrator LLM (separate server)
# The model runs on a separate inference server (e.g. the lab's a5000 machine).
# Only the backend calls it; browsers never do. Use the exact API base URL that is
# reachable FROM THE WEB SERVER, including the version prefix (often /v1), and the
# exact model id that the server lists at GET <base>/models. Nothing is guessed.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Inline editor autocomplete gets its own short limit; a late suggestion is useless.
LLM_COMPLETION_TIMEOUT_SECONDS=20
# A smaller/faster model suits completion; empty uses LLM_MODEL. Must be listed by the server's /models.
LLM_COMPLETION_MODEL=
LLM_CONNECT_TIMEOUT_SECONDS=10
# Characters of project context per request. Set to fit the served model's real context window (a long manuscript needs far more than the 24000 default;
# the production deployment runs 400000 against a 262144-token model, checked on synthetic text only: real LaTeX/Korean may need a lower value).
LLM_CONTEXT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
# auto = use what the connection test observed (tool calling > JSON mode > JSON in prompt)
LLM_PLANNING_MODE=auto
# Reasoning of the model while planning: auto (on for analyses, delegation and tool choice; off first for plain answers/edits), on, off
LLM_PLANNING_THINKING=auto

# --------------------------------------------------------- collaboration
COLLAB_ENABLED=true
# Backend -> collab service. Default http://127.0.0.1:1234; docker-compose.yml sets http://collab:1234.
# COLLAB_INTERNAL_URL=http://127.0.0.1:1234
# Browser -> collab WebSocket. Empty (recommended) = same origin at /collab: the web process
# proxies it to COLLAB_INTERNAL_URL, so the collab port never needs to be exposed.
COLLAB_PUBLIC_URL=
# REQUIRED when COLLAB_ENABLED=true: shared by backend and collab service.
COLLAB_SHARED_SECRET=
# collab service side
COLLAB_PORT=1234
COLLAB_HOST=127.0.0.1    # Compose overrides; keep it local when running without Docker
# collab -> backend. serve.sh derives it from PRISM_HOST/PRISM_PORT; docker-compose.yml sets http://web:8000.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
COLLAB_DATA_DIR=/srv/prism/collab

# ------------------------------------------------------------ compilation
# Directory containing latexmk/pdflatex (auto-detected from PATH when empty)
TEX_BIN_DIR=
# Extra read-only TeX roots for the sandbox (':'-separated). Auto-detected for TeX Live layouts.
TEX_ROOT=
# bwrap (default) or none. `none` is refused unless ALLOW_UNSANDBOXED_COMPILE=true.
COMPILE_SANDBOX=bwrap
ALLOW_UNSANDBOXED_COMPILE=false
# Let editors install the TeX Live package behind a missing .sty/.cls reported by a failed build (tlmgr, official repository only).
ALLOW_TEX_PACKAGE_INSTALL=true
# Install such packages automatically when a build fails for them (and rebuild); false = only offer the button.
TEX_PACKAGE_AUTO_INSTALL=true
COMPILE_TIMEOUT_SECONDS=180
COMPILE_MEMORY_MB=2048
COMPILE_CPU_SECONDS=300
COMPILE_MAX_PROCESSES=4096
COMPILE_MAX_OUTPUT_MB=512

# ------------------------------------------------- external agent tools
TOOL_SANDBOX=bwrap
ALLOW_UNSANDBOXED_TOOLS=false
# Extra read-only paths the tool processes need (':'-separated)
TOOL_EXTRA_RO_BINDS=
AGENT_RUN_TIMEOUT_SECONDS=600
AGENT_TASK_TIMEOUT_SECONDS=1500
# Reviewer report (Codex / Claude Code / Antigravity review in parallel, then the orchestrator merges): per tool and in total.
REVIEW_TOOL_TIMEOUT_SECONDS=1800
REVIEW_TASK_TIMEOUT_SECONDS=3600
AGENT_MAX_ATTEMPTS=2
AGENT_RECENT_FAILURE_MINUTES=30
# Order used by Auto when several tools are available (a preference, not a ranking).
AGENT_DEFAULT_ORDER=codex,claude,antigravity

# Codex CLI (`codex exec`)
CODEX_BIN=codex
# Dedicated CODEX_HOME for the service (log in once: CODEX_HOME=<dir> codex login). Default: <data>/tool-homes/codex/.codex
CODEX_HOME_DIR=
CODEX_MODEL=
# Or an API key (passed only to the codex process):
CODEX_OPENAI_API_KEY=

# Claude Code CLI (`claude -p`)
CLAUDE_BIN=claude
# Dedicated config dir (log in once: CLAUDE_CONFIG_DIR=<dir> claude /login). Default: <data>/tool-homes/claude/.claude
CLAUDE_CONFIG_DIR_FOR_TOOL=
CLAUDE_MODEL=
CLAUDE_MAX_BUDGET_USD=0
# Or an API key (enables --bare: no hooks/plugins/CLAUDE.md discovery):
CLAUDE_ANTHROPIC_API_KEY=

# Google Antigravity CLI (`agy -p`)
AGY_BIN=agy
# HOME used for agy (config in ~/.gemini/antigravity-cli). Default: <data>/tool-homes/antigravity
AGY_HOME_DIR=
AGY_MODEL=
AGY_GEMINI_API_KEY=

# ---------------------------------------------------------------- limits
PRISM_MAX_UPLOAD_MB=100
PRISM_MAX_UNZIPPED_MB=500
PRISM_MAX_ZIP_ENTRIES=5000
PRISM_MAX_TEXT_FILE_MB=4
WORKER_POLL_SECONDS=0.5
# How many projects' jobs of each kind run at once (one project's own jobs of a kind always run in order)
WORKER_COMPILE_SLOTS=3
WORKER_PROPOSAL_SLOTS=2
WORKER_AGENT_SLOTS=3
# A request that names a page limit ("fit in 8 pages") is retried this many extra times while the compiled candidate is still over it (0 = off)
PAGE_LIMIT_RETRIES=2
